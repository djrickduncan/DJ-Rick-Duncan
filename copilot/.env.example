# Copy this file to .env and fill in what you have.

# Required for smart AI suggestions (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Optional: protect the dashboard if it's reachable from the internet
DASHBOARD_PIN=

# Optional: helps connect to TikTok LIVE reliably (free key at https://www.eulerstream.com)
TIKTOK_SIGN_API_KEY=

# Optional tuning
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high         # high = rich, natural (default); medium/low = faster
# SUGGEST_MIN_GAP_MS=12000    # minimum gap between AI updates
# QUIET_CHAT_MS=75000        # nudge you when chat is quiet this long
# PORT=3000
